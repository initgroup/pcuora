# Copy to security/student.env. Use your assigned account, STUDENT01 through STUDENT20.
DB_USER=STUDENT01
DB_PASSWORD=
DB_DSN=pcuora_low
WALLET_PASSWORD=
WALLET_ZIP=security/Wallet_PCUORA.zip
# Bundled Instant Client uses cwallet.sso; no WALLET_PASSWORD is required.
# To use Thin instead, clear ORACLE_CLIENT_LIB and set WALLET_PASSWORD.
ORACLE_CLIENT_LIB=runtime/instantclient/instantclient_23_26
