{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.defaultProfile.windows": "OML (.venv)",
  "terminal.integrated.profiles.windows": {
    "OML (.venv)": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-NoExit", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\terminal-init.ps1"],
      "icon": "terminal-powershell"
    }
  },
  "files.encoding": "utf8",
  "files.exclude": {"**/__pycache__": true},
  "search.exclude": {".venv": true, "security": true, "runtime": true, "downloads": true, "backups": true, "reference/wheels": true}
}
